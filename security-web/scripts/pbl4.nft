table inet pbl4_demo {
    set protected_ips {
        type ipv4_addr
        elements = { 127.0.0.1, 192.168.20.1, 192.168.20.10 }
    }
    set blocked_ips {
        type ipv4_addr
        flags interval,timeout
        timeout 5m
    }
    chain input {
        type filter hook input priority -100; policy accept;
        iifname "lo" return
        fib saddr type local return
        ip saddr @protected_ips return
        iifname != "lo" ip saddr @blocked_ips counter drop
    }
    chain forward {
        type filter hook forward priority -100; policy accept;
        fib saddr type local return
        ip saddr @protected_ips return
        # Keep the lab anti-bypass rule without restricting other capture interfaces.
        iifname != "lo" oifname "vmnet3" ip daddr 192.168.20.10 tcp dport { 80, 443, 8080, 5173 } drop
        iifname != "lo" ip saddr @blocked_ips counter drop
    }
}
