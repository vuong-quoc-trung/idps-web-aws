[Unit]
Description=Manage explicitly authorized direct lab peer
[Service]
DynamicUser=yes
User=ws-native-ipguard
SupplementaryGroups=ws-native-evidence
ExecStart=/usr/bin/python3 -EB /opt/ws-native/runtime-fix/ip-actuator.py
StandardInput=socket
StandardOutput=journal
StandardError=journal
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RuntimeMaxSec=15s
