[Unit]
Description=Read WebSentinel prevention set
[Service]
DynamicUser=yes
ExecStart=/usr/bin/python3 -IB /opt/ws-native/runtime-fix/fw-status.py
StandardInput=socket
StandardOutput=socket
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RuntimeMaxSec=5s
