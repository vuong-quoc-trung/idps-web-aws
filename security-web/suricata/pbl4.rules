# ==============================================================================
# PBL4 Web IDPS - Suricata NIDS Rule Set
# Rules observe configured HOME_NET servers on whichever interfaces the sensor captures.
# ==============================================================================

# 1. SYN burst is a rate observation, not proof of a multi-port scan.
alert tcp any any -> $HOME_NET any (msg:"PBL4 NIDS: TCP SYN Burst Threshold"; flags:S; flow:stateless; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-recon; priority:2; sid:1000001; rev:4;)

# 2. Web Attack: SQL Injection - Boolean or Union Based
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: SQL Injection - Boolean or Union Attempt"; flow:established,to_server; http.uri; pcre:"/(union(?:[+\s]|\/\*.*?\*\/)+(?:all(?:[+\s]|\/\*.*?\*\/)+)?select|(?:\x27|%27|\x22|%22)(?:[+\s]|\/\*.*?\*\/)*(?:or|and)(?:[+\s]|\/\*.*?\*\/)+(?:\d+[+\s]*=[+\s]*\d+|(?:\x27|\x22)\w+(?:\x27|\x22)[+\s]*=[+\s]*(?:\x27|\x22)\w+))/i"; classtype:web-application-attack; priority:1; sid:1000002; rev:4;)

# 3. Time/error-based and statement SQLi indicators. Alert only by default.
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: SQL Injection - Time Blind Error or Statement Attempt"; flow:established,to_server; http.uri; url_decode; pcre:"/(?:\b(?:sleep|pg_sleep|dbms_lock\.sleep)(?:[+\s]|\/\*[^*]{0,128}\*\/)*\((?:[+\s]|\/\*[^*]{0,128}\*\/)*[0-9]|\bbenchmark(?:[+\s]|\/\*[^*]{0,128}\*\/)*\((?:[+\s]|\/\*[^*]{0,128}\*\/)*[0-9]|\bwaitfor(?:[+\s]|\/\*[^*]{0,128}\*\/)+delay(?:[+\s]|\/\*[^*]{0,128}\*\/)*[\x27\x22][0-9]{1,2}:[0-9]{1,2}:[0-9]{1,2}|\bdbms_pipe\.receive_message(?:[+\s]|\/\*[^*]{0,128}\*\/)*\(|\b(?:extractvalue|updatexml)(?:[+\s]|\/\*[^*]{0,128}\*\/)*\(|\b(?:drop|insert)(?:[+\s]|\/\*[^*]{0,128}\*\/)+(?:table|into)\b|\bexec(?:[+\s]|\/\*[^*]{0,128}\*\/)*\()/i"; classtype:web-application-attack; priority:1; sid:1000008; rev:3;)

# 4. Web Attack: Cross-Site Scripting (XSS)
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: Cross-Site Scripting (XSS) Attempt"; flow:established,to_server; http.uri; pcre:"/(<(?:script|svg|iframe|img)\b|javascript[+\s]*:|(?:onerror|onload|onmouseover)[+\s]*=)/i"; classtype:web-application-attack; priority:2; sid:1000003; rev:3;)

# 5. Inspect raw URI so path normalization cannot erase traversal segments.
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: Path Traversal or Local File Inclusion Attempt"; flow:established,to_server; http.uri.raw; pcre:"/(?:(?:\.\.|%2e%2e|%252e%252e)(?:\/|%2f|%252f|\x5c|%5c)|(?:\/|%2f)etc(?:\/|%2f)(?:passwd|shadow)|php(?:\x3a|%3a)(?:\/\/|%2f%2f)(?:filter|input)|c:(?:\x5c|%5c)windows)/i"; classtype:web-application-attack; priority:2; sid:1000004; rev:4;)

# 6. Web Attack: OS Command Injection
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: OS Command Injection Attempt"; flow:established,to_server; http.uri; pcre:"/(?:\x3b|\&|\||\x60|\$\()(?:[+\s]|\$\{IFS\})*(?:cat|id|whoami|uname|nc|sh|bash|curl|wget)\b/i"; classtype:web-application-attack; priority:1; sid:1000005; rev:3;)

# 7. Reconnaissance: Sensitive Files and Configuration Probing
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: Sensitive Configuration or Credential Probing"; flow:established,to_server; http.uri; pcre:"/(\/\.env(?:[.\/?]|$)|\/wp-config\.php|\/\.git\/(?:HEAD|config)|\/\.ssh\/(?:id_rsa|authorized_keys)|\/web\.config|\/config\.php|\/backup\.sql)/i"; classtype:attempted-recon; priority:2; sid:1000006; rev:3;)

# 8. Reconnaissance: Automated Vulnerability Scanner User-Agent
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: Automated Vulnerability Scanner User-Agent"; flow:established,to_server; http.user_agent; pcre:"/(sqlmap|nikto|dirbuster|gobuster|masscan|acunetix|nmap|zgrab|nuclei|ffuf)/i"; classtype:attempted-recon; priority:3; sid:1000007; rev:3;)

# 9. Suricata 8 transactional => associates request route and response status.
# Five failed POST logins per client in 60s; no credentials/body inspection.
# Keep SID 1000009 outside AUTO_BLOCK_SIDS; 403 may be CSRF/policy failure.
alert http any any => $HTTP_SERVERS any (msg:"PBL4 NIDS: Repeated Login 401 or 403 Responses"; http.method; content:"POST"; bsize:4; http.uri; pcre:"/^\/api\/auth\/login(?:\?|$)/"; http.stat_code; pcre:"/^40[13]$/"; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-user; priority:2; sid:1000009; rev:1;)

# 10. HTTP request-rate observation: 100 requests / 10s per client, one alert/window.
# A shared NAT/proxy can aggregate legitimate clients. Keep this SID opt-in for response.
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: HTTP Request Flood Threshold (100 requests in 10 seconds)"; flow:established,to_server; http.method; pcre:"/^[A-Z]{1,16}$/"; threshold:type both, track by_src, count 100, seconds 10; classtype:attempted-dos; priority:2; sid:1000010; rev:1;)

# 11. Executable filename AND execution primitive inside the SAME multipart part.
# Bound inspection and stop at multipart boundaries to avoid cross-file matches.
# Inspect only; no filestore/payload logging is enabled by these signatures.
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: Suspicious Web Shell File Upload"; flow:established,to_server; http.method; pcre:"/^(?:POST|PUT|PATCH)$/"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"filename="; nocase; fast_pattern; pcre:"/Content-Disposition:[^\r\n]{0,512}\bfilename\s*=\s*\x22?[^\x22\r\n]{1,128}\.(?:php[0-9]?|phtml|phar|jsp|jspx|asp|aspx|ashx)(?:\.[^\x22\r\n]{0,64})?\x22?[^\r\n]{0,128}\r?\n(?:[A-Za-z0-9-]{1,64}:[^\r\n]{0,256}\r?\n){0,8}\r?\n(?:(?!\r?\n--)[\s\S]){0,512}?(?:<\?(?:php\b|=)(?:(?!\r?\n--)[\s\S]){0,512}?\b(?:eval|assert|system|shell_exec|passthru|exec|popen)\s*\(|<%(?:(?!\r?\n--)[\s\S]){0,512}?(?:Runtime\s*\.\s*getRuntime\s*\(|new\s+ProcessBuilder\s*\(|\b(?:eval|execute|executeglobal)\s*(?:\(|request\b)|Process\s*\.\s*Start\s*\())/i"; classtype:web-application-attack; priority:1; sid:1000011; rev:1;)

# 12. URL-bearing parameter aimed at an internal/loopback/metadata/file target.
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: Possible SSRF to Internal or Metadata Target"; flow:established,to_server; http.uri; url_decode; pcre:"/(?:[?&]|^|\x22)(?:url|uri|target|dest|destination|endpoint|callback|webhook|proxy|feed|image_url|avatar_url)(?:=|\x22[+\s]*:[+\s]*\x22)(?:(?:https?|gopher|dict)\x3a\/\/(?:[^\s\/?#@]{1,128}@)?(?:127(?:\.[0-9]{1,3}){3}|10(?:\.[0-9]{1,3}){3}|192\.168(?:\.[0-9]{1,3}){2}|172\.(?:1[6-9]|2[0-9]|3[01])(?:\.[0-9]{1,3}){2}|169\.254\.169\.254|localhost(?:\.localdomain)?|metadata\.google\.internal|\[::1\])(?=[:\/?&#\x22\x27]|$)|file\x3a\/\/\/)/i"; classtype:web-application-attack; priority:2; sid:1000012; rev:1;)

# 13. Time/blind SQLi in form/JSON/plain-text request bodies (bounded by libhtp).
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: SQL Injection - Time Blind Request Body Attempt"; flow:established,to_server; http.content_type; pcre:"/^(?:application\/(?:x-www-form-urlencoded|json)|text\/plain)(?:[\x3b\s]|$)/i"; http.request_body; url_decode; url_decode; pcre:"/(?:\b(?:sleep|pg_sleep|dbms_lock\.sleep)(?:[+\s]|\/\*[^*]{0,128}\*\/)*\((?:[+\s]|\/\*[^*]{0,128}\*\/)*[0-9]|\bbenchmark(?:[+\s]|\/\*[^*]{0,128}\*\/)*\((?:[+\s]|\/\*[^*]{0,128}\*\/)*[0-9]|\bwaitfor(?:[+\s]|\/\*[^*]{0,128}\*\/)+delay(?:[+\s]|\/\*[^*]{0,128}\*\/)*[\x27\x22][0-9]{1,2}:[0-9]{1,2}:[0-9]{1,2}|\bdbms_pipe\.receive_message(?:[+\s]|\/\*[^*]{0,128}\*\/)*\()/i"; classtype:web-application-attack; priority:1; sid:1000013; rev:1;)

# 14. Same SSRF indicators in form/JSON/plain-text request bodies.
alert http any any -> $HTTP_SERVERS any (msg:"PBL4 NIDS: Possible SSRF Request Body to Internal or Metadata Target"; flow:established,to_server; http.content_type; pcre:"/^(?:application\/(?:x-www-form-urlencoded|json)|text\/plain)(?:[\x3b\s]|$)/i"; http.request_body; url_decode; url_decode; pcre:"/(?:[?&]|^|\x22)(?:url|uri|target|dest|destination|endpoint|callback|webhook|proxy|feed|image_url|avatar_url)(?:=|\x22[+\s]*:[+\s]*\x22)(?:(?:https?|gopher|dict)\x3a\/\/(?:[^\s\/?#@]{1,128}@)?(?:127(?:\.[0-9]{1,3}){3}|10(?:\.[0-9]{1,3}){3}|192\.168(?:\.[0-9]{1,3}){2}|172\.(?:1[6-9]|2[0-9]|3[01])(?:\.[0-9]{1,3}){2}|169\.254\.169\.254|localhost(?:\.localdomain)?|metadata\.google\.internal|\[::1\])(?=[:\/?&#\x22\x27]|$)|file\x3a\/\/\/)/i"; classtype:web-application-attack; priority:2; sid:1000014; rev:1;)
