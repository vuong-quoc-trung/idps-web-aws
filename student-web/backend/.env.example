# Developer defaults. Do not copy production secrets into Git.
DB_URL=jdbc:postgresql://127.0.0.1:5433/student_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
STUDENT_BIND_ADDRESS=127.0.0.1
TRUSTED_PROXIES=127.0.0.1/32,::1/128
AUDIT_INCLUDE_SUCCESSFUL_READS=true
STUDENT_AUDIT_LOG_ENABLED=true
STUDENT_AUDIT_LOG_PATH=./logs/student-audit.log
# Generate a private >=32-byte value, e.g. openssl rand -hex 32; never commit it.
STUDENT_AUDIT_HMAC_KEY=
STUDENT_SOURCE_INSTANCE=student-web
STUDENT_AUDIT_MAX_BYTES=67108864
PUBLIC_APP_URL=http://localhost:5173
