# Database configuration (PostgreSQL)
# Using Docker PostgreSQL container (port 5433 by default)
DATABASE_URL=postgres://pbl4:pbl4_dev_password@127.0.0.1:5433/pbl4_security

# Application listen address
APP_ADDR=127.0.0.1:3000

# Log sources monitored by the IDPS engine
SURICATA_EVE_PATH=/var/log/suricata/eve.json
NGINX_ACCESS_PATH=/var/log/nginx/access.log

# Firewall helper binary (invoked via sudo)
PBL4_FIREWALL_CMD=/usr/local/bin/pbl4-firewall

# Auto-blocking toggle (true: automatically block detected IPs; false: monitor/log only)
AUTO_BLOCK=false

# Log level filter (trace, debug, info, warn, error)
RUST_LOG=info

# Optional network interface and IP topology (used by deploy.sh pre-flight checks)
ATTACKER_IFACE=enp1s0
PROTECTED_IFACE=enp7s0
SECURITY_IP=192.168.10.1
WEB_SERVER_IP=192.168.20.10

# Required: configure using python3 scripts/setup-auth.py (Argon2id hashes).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Optional read-only account; an empty hash disables it.
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=
# Exact host IPs that must never be blocked (add your management hosts).
IP_WHITELIST=127.0.0.1,192.168.10.1,192.168.20.1,192.168.20.10
AUTO_BLOCK_SIDS=1000001,1000002
AUTO_BLOCK_NGINX_SQLI=true
