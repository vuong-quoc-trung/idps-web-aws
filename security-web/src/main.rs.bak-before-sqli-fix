#[derive(Clone)]
struct AppState {
    pool: PgPool,
    firewall_cmd: String,
    auto_block: bool,
}

#[derive(Debug, Serialize, FromRow)]
struct AlertRow {
    id: i64,
    occurred_at: DateTime<Utc>,
    source: String,
    event_type: String,
    src_ip: Option<String>,
    dest_ip: Option<String>,
    proto: Option<String>,
    rule_name: String,
    signature: Option<String>,
    category: Option<String>,
    severity: i16,
    action: String,
    evidence: String,
}

#[derive(Debug, Serialize, FromRow)]
struct BlockedIpRow {
    ip: String,
    reason: String,
    blocked_at: DateTime<Utc>,
    unblocked_at: Option<DateTime<Utc>>,
    active: bool,
}

#[derive(Debug, Deserialize)]
struct AlertQuery {
    limit: Option<i64>,
}

#[derive(Debug, Deserialize)]
struct BlockRequest {
    ip: String,
    reason: String,
}

#[derive(Debug, Serialize)]
struct ApiMessage {
    status: &'static str,
    message: String,
}

#[derive(Debug, Deserialize)]
struct SuricataAlertInfo {
    action: Option<String>,
    signature_id: Option<u32>,
    signature: Option<String>,
    category: Option<String>,
    severity: Option<u8>,
}

#[derive(Debug, Deserialize)]
struct SuricataEvent {
    timestamp: String,
    event_type: String,
    #[serde(default)]
    in_iface: Option<String>,
    #[serde(default)]
    src_ip: Option<IpAddr>,
    #[serde(default)]
    dest_ip: Option<IpAddr>,
    #[serde(default)]
    proto: Option<String>,
    #[serde(default)]
    alert: Option<SuricataAlertInfo>,
}

#[derive(Debug)]
struct NginxRequest {
    src_ip: IpAddr,
    method: String,
    target: String,
    status: u16,
    raw_line: String,
}

static NGINX_LOG_RE: OnceLock<Regex> = OnceLock::new();
static SQLI_RE: OnceLock<Regex> = OnceLock::new();

#[tokio::main]
async fn main() -> Result<()> {
    dotenvy::dotenv().ok();
    tracing_subscriber::fmt()
        .with_env_filter(env::var("RUST_LOG").unwrap_or_else(|_| "info".into()))
        .init();

    let database_url = env::var("DATABASE_URL").context("DATABASE_URL is not set")?;
    let app_addr = env::var("APP_ADDR").unwrap_or_else(|_| "0.0.0.0:3000".into());
    let suricata_path = env::var("SURICATA_EVE_PATH")
        .unwrap_or_else(|_| "/var/log/suricata/eve.json".into());
    let nginx_path = env::var("NGINX_ACCESS_PATH")
        .unwrap_or_else(|_| "/var/log/nginx/access.log".into());
    let firewall_cmd = env::var("PBL4_FIREWALL_CMD")
        .unwrap_or_else(|_| "/usr/local/bin/pbl4-firewall".into());
    let auto_block = env::var("AUTO_BLOCK")
        .unwrap_or_else(|_| "false".into())
        .parse::<bool>()
        .context("AUTO_BLOCK must be true or false")?;

    let pool = PgPoolOptions::new()
        .max_connections(10)
        .connect(&database_url)
        .await
        .context("cannot connect to PostgreSQL")?;

    sqlx::query("SELECT 1")
        .execute(&pool)
        .await
        .context("PostgreSQL health check failed")?;

    info!(%app_addr, %suricata_path, %nginx_path, auto_block, "security core starting");

    let suricata_pool = pool.clone();
    let suricata_firewall = firewall_cmd.clone();
    tokio::spawn(async move {
        if let Err(err) = tail_suricata(&suricata_path, suricata_pool, suricata_firewall, auto_block).await {
            error!(error = %err, "Suricata watcher stopped");
        }
    });

    let nginx_pool = pool.clone();
    let nginx_firewall = firewall_cmd.clone();
    tokio::spawn(async move {
        if let Err(err) = tail_nginx(&nginx_path, nginx_pool, nginx_firewall, auto_block).await {
            error!(error = %err, "Nginx watcher stopped");
        }
    });

    let state = AppState { pool, firewall_cmd, auto_block };
    let app = Router::new()
        .route("/", get(dashboard))
        .route("/health", get(health))
        .route("/api/alerts", get(list_alerts))
        .route("/api/blocked-ips", get(list_blocked_ips).post(block_ip))
        .route("/api/blocked-ips/{ip}", delete(unblock_ip))
        .layer(TraceLayer::new_for_http())
        .with_state(state);

    let listener = TcpListener::bind(&app_addr)
        .await
        .with_context(|| format!("cannot bind {app_addr}"))?;
    info!(%app_addr, "dashboard/API listening");
    axum::serve(listener, app).await?;
    Ok(())
}

async fn health() -> &'static str {
    "OK"
}

async fn list_alerts(
    State(state): State<AppState>,
    Query(query): Query<AlertQuery>,
) -> Result<Json<Vec<AlertRow>>, (StatusCode, String)> {
    let limit = query.limit.unwrap_or(50).clamp(1, 200);
    let rows = sqlx::query_as::<_, AlertRow>(
        r#"SELECT id, occurred_at, source, event_type,
                src_ip::text,
                dest_ip::text,
                proto,
                rule_name, signature, category, severity, action, evidence
        FROM security_alerts
        ORDER BY id DESC
        LIMIT $1"#,
    )
    .bind(limit)
    .fetch_all(&state.pool)
    .await
    .map_err(internal_error)?;
    Ok(Json(rows))
}

async fn list_blocked_ips(
    State(state): State<AppState>,
) -> Result<Json<Vec<BlockedIpRow>>, (StatusCode, String)> {
    let rows = sqlx::query_as::<_, BlockedIpRow>(
    r#"SELECT ip::text, reason, blocked_at, unblocked_at, active
    FROM blocked_ips
    WHERE active = true
    ORDER BY blocked_at DESC"#,
    )
    .fetch_all(&state.pool)
    .await
    .map_err(internal_error)?;
    Ok(Json(rows))
}

async fn block_ip(
    State(state): State<AppState>,
    Json(request): Json<BlockRequest>,
) -> Result<(StatusCode, Json<ApiMessage>), (StatusCode, String)> {
    let ip = validate_lab_attacker_ip(&request.ip).map_err(client_error)?;
    if request.reason.trim().is_empty() {
        return Err((StatusCode::BAD_REQUEST, "reason is required".into()));
    }

    firewall_action(&state.firewall_cmd, "block", &ip).await.map_err(internal_string_error)?;

    sqlx::query(
    r#"INSERT INTO blocked_ips (ip, reason, blocked_at, unblocked_at, active)
    VALUES ($1::inet, $2, now(), NULL, true)
    ON CONFLICT (ip) DO UPDATE
    SET reason = EXCLUDED.reason,
        blocked_at = now(),
        unblocked_at = NULL,
        active = true"#,
    )
    .bind(ip.to_string())
    .bind(&request.reason)
    .execute(&state.pool)
    .await
    .map_err(internal_error)?;

    record_firewall_action(&state.pool, ip, "BLOCK", "API", &request.reason, "SUCCESS", None)
        .await
        .map_err(internal_string_error)?;

    Ok((
        StatusCode::CREATED,
        Json(ApiMessage { status: "ok", message: format!("blocked {ip}") }),
    ))
}

async fn unblock_ip(
    State(state): State<AppState>,
    Path(ip): Path<String>,
) -> Result<Json<ApiMessage>, (StatusCode, String)> {
    let ip = validate_lab_attacker_ip(&ip).map_err(client_error)?;
    firewall_action(&state.firewall_cmd, "unblock", &ip)
        .await
        .map_err(internal_string_error)?;

        sqlx::query(
            "UPDATE blocked_ips
            SET active = false, unblocked_at = now()
            WHERE ip = $1::inet"
        )
        .bind(ip.to_string())
        .execute(&state.pool)
        .await
        .map_err(internal_error)?;

    record_firewall_action(&state.pool, ip, "UNBLOCK", "API", "manual unblock", "SUCCESS", None)
        .await
        .map_err(internal_string_error)?;

    Ok(Json(ApiMessage { status: "ok", message: format!("unblocked {ip}") }))
}

