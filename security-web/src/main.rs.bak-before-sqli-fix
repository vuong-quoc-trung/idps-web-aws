async fn tail_suricata(path: &str, pool: PgPool, firewall_cmd: String, auto_block: bool) -> Result<()> {
    tail_file(path, move |line| {
        let pool = pool.clone();
        let firewall_cmd = firewall_cmd.clone();
        async move {
            if let Err(err) = process_suricata_line(&line, &pool, &firewall_cmd, auto_block).await {
                warn!(error = %err, "failed to process Suricata line");
            }
            Ok(())
        }
    }).await
}

async fn tail_nginx(path: &str, pool: PgPool, firewall_cmd: String, auto_block: bool) -> Result<()> {
    tail_file(path, move |line| {
        let pool = pool.clone();
        let firewall_cmd = firewall_cmd.clone();
        async move {
            if let Err(err) = process_nginx_line(&line, &pool, &firewall_cmd, auto_block).await {
                warn!(error = %err, "failed to process Nginx line");
            }
            Ok(())
        }
    }).await
}

async fn tail_file<F, Fut>(path: &str, mut handler: F) -> Result<()>
where
    F: FnMut(String) -> Fut,
    Fut: std::future::Future<Output = Result<()>>,
{
    loop {
        if !FsPath::new(path).exists() {
            warn!(%path, "log file does not exist; waiting");
            sleep(Duration::from_secs(2)).await;
            continue;
        }

        let mut file = OpenOptions::new().read(true).open(path).await?;
        let start = file.metadata().await?.len();
        file.seek(SeekFrom::End(0)).await?;
        let mut offset = start;
        let mut pending = Vec::new();
        info!(%path, "watching log file from EOF");

        loop {
            let size = match file.metadata().await { Ok(m) => m.len(), Err(_) => break };
            if size < offset { break; }
            if size > offset {
                file.seek(SeekFrom::Start(offset)).await?;
                let mut chunk = Vec::with_capacity((size - offset) as usize);
                let mut limited = (&mut file).take(size - offset);
                limited.read_to_end(&mut chunk).await?;
                offset = size;
                pending.extend_from_slice(&chunk);
                while let Some(pos) = pending.iter().position(|b| *b == b'\n') {
                    let line = pending.drain(..=pos).collect::<Vec<_>>();
                    let line = String::from_utf8_lossy(&line).trim_end_matches(&['\r','\n'][..]).to_string();
                    if !line.is_empty() { handler(line).await?; }
                }
            }
            sleep(Duration::from_millis(500)).await;
        }
    }
}

async fn process_suricata_line(line: &str, pool: &PgPool, firewall_cmd: &str, auto_block: bool) -> Result<()> {
    let event: SuricataEvent = match serde_json::from_str(line) { Ok(e) => e, Err(_) => return Ok(()) };
    if event.event_type != "alert" { return Ok(()); }
    let Some(alert) = event.alert else { return Ok(()); };

    let severity = alert.severity.unwrap_or(3).clamp(1, 5) as i16;
    let signature = alert.signature.clone().unwrap_or_else(|| "Unknown Suricata alert".into());
    let category = alert.category.clone().unwrap_or_else(|| "Suricata alert".into());
    let action = alert.action.clone().unwrap_or_else(|| "allowed".into());
    let rule_name = format!("SURICATA: {signature}");
    let occurred_at = parse_suricata_timestamp(&event.timestamp).unwrap_or_else(|_| Utc::now());
    let evidence = format!(
        "iface={} signature_id={:?} signature={} src={:?} dst={:?} proto={:?}",
        event.in_iface.as_deref().unwrap_or("-"), alert.signature_id, signature, event.src_ip, event.dest_ip, event.proto
    );

    insert_alert(pool, occurred_at, "SURICATA", "alert", event.src_ip, event.dest_ip, event.proto.as_deref(), &rule_name, alert.signature.as_deref(), Some(&category), severity, &action, &evidence).await?;

    maybe_auto_block(pool, firewall_cmd, auto_block, event.src_ip, severity, &rule_name).await
}

async fn process_nginx_line(line: &str, pool: &PgPool, firewall_cmd: &str, auto_block: bool) -> Result<()> {
    let Some(request) = parse_nginx_request(line) else { return Ok(()); };
    let decoded = urlencoding::decode(&request.target).map(|v| v.into_owned()).unwrap_or_else(|_| request.target.clone()).replace('+', " ");

    if sql_injection_re().is_match(&decoded) {
        let evidence = format!("{} {} status={} target={} raw={}", request.method, request.target, request.status, decoded, request.raw_line);
        insert_alert(pool, Utc::now(), "NGINX", "waf", Some(request.src_ip), Some("192.168.20.10".parse::<IpAddr>().unwrap()), Some("HTTP"), "NGINX: SQL Injection", None, Some("Web Application Attack"), 2, "ALERT", &evidence).await?;
        maybe_auto_block(pool, firewall_cmd, auto_block, Some(request.src_ip), 2, "NGINX: SQL Injection").await?;
    }
    Ok(())
}

async fn maybe_auto_block(pool: &PgPool, firewall_cmd: &str, auto_block: bool, src_ip: Option<IpAddr>, severity: i16, rule_name: &str) -> Result<()> {
    if !auto_block || severity > 2 { return Ok(()); }
    let Some(ip) = src_ip else { return Ok(()); };
    if let Err(err) = validate_lab_attacker_ip(&ip.to_string()) { warn!(%ip, error=%err, "skip auto-block for non-lab source"); return Ok(()); }

    firewall_action(firewall_cmd, "block", &ip).await?;
    sqlx::query(
        r#"INSERT INTO blocked_ips (ip, reason, blocked_at, unblocked_at, active)
           VALUES ($1::inet, $2, now(), NULL, true)
           ON CONFLICT (ip) DO UPDATE SET reason = EXCLUDED.reason, blocked_at = now(), unblocked_at = NULL, active = true"#,
    )
    .bind(ip.to_string())
    .bind(format!("auto-block: {rule_name}"))
    .execute(pool)
    .await?;
    record_firewall_action(pool, ip, "BLOCK", "AUTO", rule_name, "SUCCESS", None).await?;
    info!(%ip, %rule_name, "auto-blocked source IP");
    Ok(())
}

fn parse_suricata_timestamp(value: &str) -> Result<DateTime<Utc>> {
    Ok(DateTime::parse_from_str(value, "%Y-%m-%dT%H:%M:%S%.f%z")?.with_timezone(&Utc))
}

fn parse_nginx_request(line: &str) -> Option<NginxRequest> {
    let re = NGINX_LOG_RE.get_or_init(|| Regex::new(r#"^(\S+) \S+ \S+ \[[^\]]+\] \"(\S+) ([^\"]+) HTTP/[0-9.]+\" (\d{3}) "#).expect("valid nginx regex"));
    let caps = re.captures(line)?;
    Some(NginxRequest {
        src_ip: caps.get(1)?.as_str().parse().ok()?,
        method: caps.get(2)?.as_str().to_string(),
        target: caps.get(3)?.as_str().to_string(),
        status: caps.get(4)?.as_str().parse().ok()?,
        raw_line: line.to_string(),
    })
}

fn sql_injection_re() -> &'static Regex {
    SQLI_RE.get_or_init(|| Regex::new(r"(?i)(union\s+select|'\s*(?:or|and)\s+\d+\s*=\s*\d+|\b(?:or|and)\s+\d+\s*=\s*\d+|sleep\s*\(|information_schema)").expect("valid SQLi regex"))
}

async fn insert_alert(
    pool: &PgPool, occurred_at: DateTime<Utc>, source: &str, event_type: &str,
    src_ip: Option<IpAddr>, dest_ip: Option<IpAddr>, proto: Option<&str>, rule_name: &str,
    signature: Option<&str>, category: Option<&str>, severity: i16, action: &str, evidence: &str,
) -> Result<()> {
    sqlx::query(
        r#"INSERT INTO security_alerts
        (occurred_at, source, event_type, src_ip, dest_ip, proto, rule_name, signature, category, severity, action, evidence)
       VALUES ($1,$2,$3,$4::inet,$5::inet,$6,$7,$8,$9,$10,$11,$12)"#,
    ).bind(occurred_at).bind(source).bind(event_type).bind(src_ip.map(|ip| ip.to_string()))
.bind(dest_ip.map(|ip| ip.to_string())).bind(proto)
     .bind(rule_name).bind(signature).bind(category).bind(severity).bind(action).bind(evidence)
     .execute(pool).await?;
    info!(%source, %rule_name, %action, ?src_ip, "security alert stored");
    Ok(())
}

async fn record_firewall_action(
    pool: &PgPool, ip: IpAddr, action: &str, source: &str, reason: &str, status: &str, details: Option<&str>
) -> Result<()> {
        sqlx::query(
        "INSERT INTO firewall_actions
        (ip, action, source, reason, status, details)
        VALUES ($1::inet,$2,$3,$4,$5,$6)"
    )
        .bind(ip.to_string()).bind(action).bind(source).bind(reason).bind(status).bind(details).execute(pool).await?;
    Ok(())
}

async fn firewall_action(cmd: &str, action: &str, ip: &IpAddr) -> Result<()> {
    let output = Command::new("sudo").arg(cmd).arg(action).arg(ip.to_string()).output().await
        .with_context(|| format!("failed to execute firewall helper {cmd}"))?;
    if !output.status.success() {
        bail!("firewall helper failed: {}", String::from_utf8_lossy(&output.stderr));
    }
    Ok(())
}

fn validate_lab_attacker_ip(value: &str) -> Result<IpAddr> {
    let ip: IpAddr = value.parse().context("invalid IP address")?;
    let octets = match ip {
        IpAddr::V4(v4) => v4.octets(),
        IpAddr::V6(_) => bail!("only IPv4 lab attacker addresses are allowed"),
    };
    if octets[0] != 192 || octets[1] != 168 || octets[2] != 10 || !(2..=254).contains(&octets[3]) {
        bail!("only 192.168.10.2-192.168.10.254 may be blocked in this demo");
    }
    Ok(ip)
}

fn client_error(error: anyhow::Error) -> (StatusCode, String) {
    (StatusCode::BAD_REQUEST, error.to_string())
}

fn internal_string_error(error: anyhow::Error) -> (StatusCode, String) {
    (StatusCode::INTERNAL_SERVER_ERROR, error.to_string())
}

fn internal_error(error: sqlx::Error) -> (StatusCode, String) {
    (StatusCode::INTERNAL_SERVER_ERROR, format!("database error: {error}"))
}
